{
  "name": "facturaexpress-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.5"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check": "npm run check:tokens && npm run check:contraste && npm run test && npm run build",
    "check:contraste": "node scripts/check-contraste.mjs"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
